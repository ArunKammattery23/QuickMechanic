# Ignore sensitive documentation
docs/CREDENTIALS.md

# Ignore node_modules
node_modules/
**/node_modules/

# Ignore generated build output and local analysis artifacts
**/build/
**/.next/
*.tsbuildinfo
graphify-out/
scratch/
*.log

# Ignore environment files
.env
.env.production
.env.development
.env.local

# Android release signing material must remain local and private
**/key.properties
**/*.jks
**/*.keystore

# Database CA bundles live locally; the connection URI treats them as public,
# but keep managed-service material out of the repo by default.
backend/certs/

# Local Android cmdline-tools download (155 MB zip + extracted SDK; GitHub refuses >100 MB)
.android-tools/

# Local OAuth client-config helper file (public IDs only, but reset per project)
config/google-auth.local.json

# Play Console verification artifacts: backend/auth result dumps, screenshots, logs
play-store-assets/**/backend-results.json
play-store-assets/**/auth-results.json
play-store-assets/*.log

# Embedded sibling repositories (each is a separate git project)
quickmechanic-site/
quickmechanic-site-deploy/
voyanx-website/

# Ignore OS files
.DS_Store
Thumbs.db

# Generated local routing datasets
data/routing/
# Local Play Console reviewer credentials (never commit)
play-store-assets/reviewer-credentials.local.json

# Local-only QA account passwords generated by verification scripts
play-store-assets/**/local-qa-credentials.local.json
