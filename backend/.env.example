# Copy the needed settings into .env.development; keep live settings separate.
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password123
DB_NAME=QuickMechanic
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Set your own signing secret. Required in production.
JWT_SECRET=
# Public demonstration router; use a self-hosted router for sustained traffic.
OSRM_BASE_URL=https://router.project-osrm.org
# Comma-separated TURN URLs and coturn's shared authentication secret.
# Both must be configured to enable temporary TURN credentials.
TURN_URLS=
TURN_SECRET=
SMTP_USER=
SMTP_PASSWORD=
# Set server-side only; configure the payment_link.paid webhook before enabling checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# simulation (no keys), razorpay_test (rzp_test_ keys), or live (rzp_live_ keys).
# Use a separate database per mode. Never turn test balances into live balances.
PAYMENT_MODE=live
