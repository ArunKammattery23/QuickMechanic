# QuickMechanic — production env template (copy to .env.production and fill in).
# .env.production is gitignored; never commit real secrets.

NODE_ENV=production
PORT=3000

# --- Aiven managed PostgreSQL (free tier) ---
DB_HOST=quckmechanicdb-arunkammattery-3290.b.aivencloud.com
DB_PORT=25857
DB_USER=avnadmin
DB_PASSWORD=<paste-your-ROTATED-aiven-password>
DB_NAME=defaultdb
DB_SSL=true
# Path to Aiven project CA (relative to backend/ working dir, or absolute)
DB_CA_PATH=certs/aiven-ca.pem

# --- Redis (set up a free Upstash instance next) ---
REDIS_HOST=
REDIS_PORT=6379

# --- Secrets (generate strong values) ---
JWT_SECRET=
GOOGLE_WEB_CLIENT_ID=

# --- Routing, TURN, email, payments ---
OSRM_BASE_URL=https://router.project-osrm.org
TURN_URLS=
TURN_SECRET=
SMTP_USER=
SMTP_PASSWORD=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_MODE=simulation
